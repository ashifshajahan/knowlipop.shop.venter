FAST2SMS_API_KEY=

# Razorpay Test / Live Mode Payment Gateway Credentials
# For Test Mode, obtain from Razorpay Dashboard -> Settings -> API Keys (starts with rzp_test_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook Secret from Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
# Marketplace commission rate (e.g. 0.05 for 5%)
MARKETPLACE_COMMISSION_RATE=0.05
# Keep seller payouts separate until Razorpay Route is enabled and configured (default: false)
RAZORPAY_ROUTE_ENABLED=false
RETURN_WINDOW_DAYS=7

# Hostinger Business Email (SMTP) Configuration
