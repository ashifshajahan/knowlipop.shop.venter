    {
      "name": "6. Password Reset Flow (OTP)",
      "item": [
        {
          "name": "1. Request OTP (POST /api/forgot-password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.dev_otp) {",
                  "    pm.collectionVariables.set('otp_code', jsonData.dev_otp);",
                  "    if (pm.environment) pm.environment.set('otp_code', jsonData.dev_otp);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{seller_phone}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/forgot-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "forgot-password"
              ]
            },
            "description": "Sends password reset OTP. In dev/testing mode, the response also includes dev_otp, which is automatically saved to {{otp_code}}!"
          },
          "response": []
        },
        {
          "name": "2. Verify OTP (POST /api/verify-otp)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('OTP verified with reset_token', function () {",
                  "    pm.expect(jsonData.reset_token).to.be.a('string');",
                  "});",
                  "if (jsonData.reset_token) {",
                  "    pm.collectionVariables.set('reset_token', jsonData.reset_token);",
                  "    if (pm.environment) pm.environment.set('reset_token', jsonData.reset_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{seller_phone}}\",\n  \"code\": \"{{otp_code}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/verify-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "verify-otp"
              ]
            },
            "description": "Verifies OTP code and returns reset_token, saving it to {{reset_token}}."
          },
          "response": []
        },
