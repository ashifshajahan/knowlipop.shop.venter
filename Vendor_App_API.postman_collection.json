    {
      "name": "3. Password Reset Flow (OTP)",
      "item": [
        {
          "name": "1. Request OTP (POST /api/forgot-password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.dev_otp) {",
                  "    pm.collectionVariables.set(\"otp_code\", jsonData.dev_otp);",
                  "    pm.environment.set(\"otp_code\", jsonData.dev_otp);",
                  "    console.log(\"Saved OTP code:\", jsonData.dev_otp);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+919989162203\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/forgot-password",
              "host": ["{{base_url}}"],
              "path": ["api", "forgot-password"]
            },
            "description": "Sends password reset OTP. In dev/testing mode, the response also includes dev_otp, which is automatically saved to {{otp_code}}!"
          },
          "response": []
        },
        {
          "name": "2. Verify OTP (POST /api/verify-otp)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.reset_token) {",
                  "    pm.collectionVariables.set(\"reset_token\", jsonData.reset_token);",
                  "    pm.environment.set(\"reset_token\", jsonData.reset_token);",
                  "    console.log(\"Saved Reset Token:\", jsonData.reset_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+919989162203\",\n  \"code\": \"{{otp_code}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/verify-otp",
              "host": ["{{base_url}}"],
              "path": ["api", "verify-otp"]
            },
            "description": "Verifies OTP code and returns reset_token, saving it to {{reset_token}}."
          },
          "response": []
        },
        {
          "name": "3. Reset Password (POST /api/reset-password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+919989162203\",\n  \"reset_token\": \"{{reset_token}}\",\n  \"password\": \"ResetPassword123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/reset-password",
              "host": ["{{base_url}}"],
              "path": ["api", "reset-password"]
            },
            "description": "Sets new password using verified reset_token."
          },
          "response": []
        }
      ]
    },
