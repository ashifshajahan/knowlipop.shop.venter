            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Smart Wireless Headset (Pro Edition)\",\n  \"price\": 3499.00,\n  \"stock\": 75,\n  \"description\": \"Updated upgraded sound with Spatial Audio.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/products/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "products", "{{product_id}}"]
            },
            "description": "Updates fields of an existing product owned by the authenticated seller."
          },
          "response": []
        },
        {
          "name": "Delete Product (DELETE /api/products/:id)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/products/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "products", "{{product_id}}"]
            },
            "description": "Deletes the product."
          },
          "response": []
        }
      ]
