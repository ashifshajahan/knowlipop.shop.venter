        {
          "name": "Create Product (POST /api/products)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.product && jsonData.product.id) {",
                  "    pm.collectionVariables.set(\"product_id\", jsonData.product.id);",
                  "    pm.environment.set(\"product_id\", jsonData.product.id);",
                  "    console.log(\"Saved product_id:\", jsonData.product.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Smart Wireless Headset\",\n  \"description\": \"Active noise cancelling over-ear headphones with 40-hour battery life.\",\n  \"price\": 2999.00,\n  \"stock\": 50,\n  \"image_url\": \"https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=500\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/products",
              "host": ["{{base_url}}"],
              "path": ["api", "products"]
            },
            "description": "Creates a new product associated with the authenticated seller. Automatically captures product_id."
          },
          "response": []
        },
        {
          "name": "Get Product Details (GET /api/products/:id)",
          "request": {
