    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Register Seller (POST /api/register)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.token);",
                  "    pm.environment.set(\"token\", jsonData.token);",
                  "    console.log(\"Saved token to environment:\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seller_name\": \"Apex Store {{ $randomInt }}\",\n  \"phone\": \"+91987{{ $randomInt }}12\",\n  \"address\": \"452 MG Road, Suite 300\",\n  \"landmark\": \"Opposite Tech Park\",\n  \"state\": \"Kerala\",\n  \"country\": \"India\",\n  \"password\": \"SecretPass123!\",\n  \"password_confirmation\": \"SecretPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/register",
              "host": ["{{base_url}}"],
              "path": ["api", "register"]
            },
            "description": "Registers a new seller. Note: phone uses random integer so this can be clicked repeatedly without duplicate phone errors. Automatically saves the returned Bearer token into {{token}}."
          },
          "response": []
        },
        {
          "name": "Login Seller (POST /api/login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.token);",
                  "    pm.environment.set(\"token\", jsonData.token);",
                  "    console.log(\"Saved token:\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+919989162203\",\n  \"password\": \"ResetPassword123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": ["{{base_url}}"],
              "path": ["api", "login"]
            },
            "description": "Logs in the seller and automatically saves JWT Bearer token into {{token}} for all subsequent requests."
          },
          "response": []
        },
        {
          "name": "Get Current Profile (GET /api/me)",
          "request": {
