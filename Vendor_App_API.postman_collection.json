    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Register Seller (POST /api/register)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate fresh unique phone number for registration",
                  "var randomSuffix = Math.floor(1000000 + Math.random() * 9000000);",
                  "var phone = '+91987' + randomSuffix;",
                  "var password = 'SecretPass123!';",
                  "pm.collectionVariables.set('seller_phone', phone);",
                  "pm.collectionVariables.set('seller_password', password);",
                  "if (pm.environment) {",
                  "    pm.environment.set('seller_phone', phone);",
                  "    pm.environment.set('seller_password', password);",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Returns Bearer token', function () {",
                  "    pm.expect(jsonData.token).to.be.a('string');",
                  "    pm.expect(jsonData.token_type).to.eql('Bearer');",
                  "});",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    if (pm.environment) pm.environment.set('token', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seller_name\": \"Apex Store\",\n  \"phone\": \"{{seller_phone}}\",\n  \"address\": \"452 MG Road, Suite 300\",\n  \"landmark\": \"Opposite Tech Park\",\n  \"state\": \"Kerala\",\n  \"country\": \"India\",\n  \"password\": \"{{seller_password}}\",\n  \"password_confirmation\": \"{{seller_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "register"
              ]
            },
            "description": "Registers a new seller with dynamically generated phone. Automatically saves returned Bearer token into {{token}}."
          },
          "response": []
        },
